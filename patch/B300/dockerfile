# ====================================== Install miniTransformer ============================================

ARG MINITRANSFORMER_REPO=fy1214/miniTransformer
# Branch must ship cutlass-dsl 4.6 ReduxKind->ReductionKind compat for CuTeDSL.
ARG MINITRANSFORMER_BRANCH=infix_main_op_pr#3045

# Compile fp4_gemm (sm_100a / sm_103a). Docker build usually has no GPU, so force
# Blackwell ops instead of probing torch.cuda.get_device_capability().
# --no-deps: pyproject pulls torch + nvidia-*-cu12, which duplicates the CUDA13 stack (~11GB).
# Cutlass must stay on CUTLASS_DSL_VERSION (4.6.2): matches quack/FA4 and TE cute path.
# miniTE sources must include ReduxKind->ReductionKind compat for cutlass-dsl 4.6+.
ARG CUTLASS_DSL_VERSION=4.6.2
# Private repo: pass --secret id=gh_token,src=... (BuildKit). Falls back to
# public HTTPS clone when the secret is absent (local public mirrors only).
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.ccache \
    --mount=type=secret,id=gh_token \
    set -eu; \
    if [ -f /run/secrets/gh_token ]; then \
      TOKEN="$(cat /run/secrets/gh_token)"; \
      MT_URL="https://x-access-token:${TOKEN}@github.com/${MINITRANSFORMER_REPO}.git"; \
    else \
      MT_URL="https://github.com/${MINITRANSFORMER_REPO}.git"; \
    fi; \
    git clone --depth 1 --branch "${MINITRANSFORMER_BRANCH}" \
      --recurse-submodules --shallow-submodules \
      "${MT_URL}" /root/miniTransformer; \
    cd /root/miniTransformer; \
    git remote set-url origin "https://github.com/${MINITRANSFORMER_REPO}.git"; \
    pip install --no-deps nvtx scipy "cuda-core==0.7.0" \
      "nvidia-cutlass-dsl==${CUTLASS_DSL_VERSION}" \
      "nvidia-cutlass-dsl[cu13]==${CUTLASS_DSL_VERSION}"; \
    CUDA_HOME=/usr/local/cuda \
    MINI_TE_FORCE_BLACKWELL_OPS=1 \
    HYBRID_CUDA_ARCHS="100a;103a" \
    MAX_JOBS=$(nproc) \
    pip install -e . --no-build-isolation --no-deps; \
    rm -rf /root/miniTransformer/third-party/cutlass/.git /root/miniTransformer/.git/modules

# int4_qat
RUN pip install /tmp/wheels/fake_int4_quant_cuda-*.whl

# ====================================== Install sgl-model-gateway ============================================
#   SGL_ROUTER_USE_WHEELS=0:
#     Build from source  https://github.com/radixark/sgl-router-for-miles
#   SGL_ROUTER_USE_WHEELS=1 (default):
#     Install the pre-built sgl-model-gateway wheel

ARG SGL_ROUTER_USE_WHEELS=1
ARG SGL_ROUTER_REPO=https://github.com/radixark/sgl-router-for-miles.git
ARG SGL_ROUTER_BRANCH=main

RUN --mount=type=cache,target=/root/.cache/pip \
    set -eu; \
    if [ "${SGL_ROUTER_USE_WHEELS}" = "1" ]; then \
      pip install --force-reinstall /tmp/wheels/sglang_router-*.whl && \
      tar xzf /tmp/wheels/sgl-model-gateway-linux-*.tar.gz -C /usr/local/bin/ && \
      chmod +x /usr/local/bin/sgl-model-gateway; \
    elif [ "${SGL_ROUTER_USE_WHEELS}" = "0" ]; then \
      git clone --branch "${SGL_ROUTER_BRANCH}" --depth 1 "${SGL_ROUTER_REPO}" /build/sgl-model-gateway && \
      curl --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 -sSf https://sh.rustup.rs | sh -s -- -y && \
      export PATH="/root/.cargo/bin:${PATH}" && \
      python3 -m pip install maturin && \
      cd /build/sgl-model-gateway/bindings/python && \
      ulimit -n 65536 && \
      maturin build --release --features vendored-openssl --out /build/gateway_wheels && \
      cd /build/sgl-model-gateway && \
      cargo build --release --bin sgl-model-gateway --features vendored-openssl && \
      cp target/release/sgl-model-gateway /usr/local/bin/sgl-model-gateway && \
      chmod +x /usr/local/bin/sgl-model-gateway && \
      pip install --force-reinstall /build/gateway_wheels/sglang_router-*.whl && \
      rm -rf /root/.cargo /root/.rustup /build/sgl-model-gateway /build/gateway_wheels; \
    fi

RUN rm -rf /tmp/wheels

# Align with mingfa-docker (1.0.3): sglang flashinfer_trtllm NVFP4 path
# calls nvfp4_quantize(..., per_token_activation=True), which exists in 0.6.12
# but not in the base-image 0.6.8.post1.
# --no-deps: avoid pulling a second torch / cutlass stack.
# Uninstall base-image jit-cache; 0.6.8 cache fails flashinfer's version check.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip uninstall -y flashinfer-jit-cache || true && \
    pip install --no-deps flashinfer-python==0.6.12 flashinfer-cubin==0.6.12

# Align with mingfa-docker: unreplaced TE Linear layers must not stay on FP8.
# Editable TE lives under /root/TransformerEngine; fall back to site-packages.
RUN printf '%s\n' \
    'from pathlib import Path' \
    'candidates = [' \
    '    Path("/root/TransformerEngine/transformer_engine/pytorch/module"),' \
    '    Path("/usr/local/lib/python3.12/dist-packages/transformer_engine/pytorch/module"),' \
    ']' \
    'te_dir = next((p for p in candidates if p.is_dir()), None)' \
    'if te_dir is None:' \
    '    raise SystemExit("TE pytorch/module not found for FP8 disable patch")' \
    'anchor = ") = non_tensor_args\n"' \
    'insert = anchor + "\n        # miniTE-b300: disable FP8 fallback for unreplaced Linear layers\n        fp8 = False\n\n"' \
    'for name in ("linear.py", "layernorm_linear.py"):' \
    '    path = te_dir / name' \
    '    text = path.read_text()' \
    '    if "fp8 = False" in text:' \
    '        print("already patched", path)' \
    '        continue' \
    '    if anchor not in text:' \
    '        raise SystemExit("anchor not found in %s" % path)' \
    '    path.write_text(text.replace(anchor, insert, 1))' \
    '    print("patched", path)' \
    > /tmp/patch_te_disable_fp8.py && python3 /tmp/patch_te_disable_fp8.py && rm -f /tmp/patch_te_disable_fp8.py

# Precompile FlashInfer NVFP4 + fused MoE kernels for this machine's GPU.
# B200 -> 10.0 (sm_100a), B300 -> 10.3 (sm_103a). Override with
# --build-arg FLASHINFER_CUDA_ARCH_LIST=10.0 (or 10.3). Docker build usually
# has no GPU: then both arches are compiled so the image runs on either box.
ARG FLASHINFER_CUDA_ARCH_LIST=""
RUN printf '%s\n' \
    'import os, shutil, subprocess, sys' \
    'from pathlib import Path' \
    '' \
    'def detect_archs():' \
    '    override = os.environ.get("FLASHINFER_CUDA_ARCH_LIST", "").strip()' \
    '    if override:' \
    '        return override.split()' \
    '    try:' \
    '        import torch' \
    '        if torch.cuda.is_available() and torch.cuda.device_count() > 0:' \
    '            major, minor = torch.cuda.get_device_capability(0)' \
    '            return ["%d.%d" % (major, minor)]' \
    '    except Exception as e:' \
    '        print("gpu probe skipped:", e)' \
    '    return ["10.0", "10.3"]' \
    '' \
    'warmup_one = r"""' \
    'import os' \
    'arch = os.environ["FLASHINFER_CUDA_ARCH_LIST"]' \
    'print("==> warmup FLASHINFER_CUDA_ARCH_LIST=%s" % arch)' \
    'from flashinfer.jit.fused_moe import gen_trtllm_gen_fused_moe_sm100_module' \
    'from flashinfer.jit.fp4_quantization import (' \
    '    gen_fp4_quantization_sm100_module,' \
    '    gen_fp4_quantization_sm103_module,' \
    ')' \
    'if arch.startswith("10.3"):' \
    '    gen_fp4_quantization_sm103_module().build(False)' \
    'else:' \
    '    gen_fp4_quantization_sm100_module().build(False)' \
    'gen_trtllm_gen_fused_moe_sm100_module().build(False)' \
    '"""' \
    '' \
    'cache_root = Path("/root/.cache/flashinfer")' \
    'if cache_root.exists():' \
    '    for stale in cache_root.glob("0.6.8*"):' \
    '        print("remove stale cache:", stale)' \
    '        shutil.rmtree(stale, ignore_errors=True)' \
    'for arch in detect_archs():' \
    '    env = dict(os.environ)' \
    '    env["FLASHINFER_CUDA_ARCH_LIST"] = arch' \
    '    subprocess.check_call([sys.executable, "-c", warmup_one], env=env)' \
    'so_files = sorted(Path("/root/.cache/flashinfer").rglob("*.so"))' \
    'print("warmup done: %d shared objects" % len(so_files))' \
    'for so in so_files:' \
    '    print("  %s (%d MiB)" % (so, so.stat().st_size // (1024 * 1024)))' \
    > /tmp/warmup_flashinfer.py && FLASHINFER_CUDA_ARCH_LIST="${FLASHINFER_CUDA_ARCH_LIST}" python3 /tmp/warmup_flashinfer.py && rm -f /tmp/warmup_flashinfer.py