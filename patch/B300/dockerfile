# miniTE image based on radixark/miles Dockerfile, with local patched repos:
#   slime           -> https://github.com/fy1214/slime            branch b300-minite-patched
#   Megatron        -> https://github.com/fy1214/Megatron-LM      branch b300-minite-patched
#   sglang          -> https://github.com/fy1214/sglang           branch b300-minite-patched
#   miniTransformer -> https://github.com/fy1214/miniTransformer  branch infix_main_op_pr#3045
#                     (must include cutlass-dsl 4.6 ReduxKind compat for CuTeDSL)
#   TransformerEngine -> fy1214/TransformerEngine @ feature/grouped-per-token-sf-swizzle
#
# Image hardening checklist:
#   1) Pin sglang BASE by digest (default v0.5.12-cu130 below)
#   2) Build flash_attn FA2 from source against that torch (not miles wheel)
#   3) Pin nvidia-cutlass-dsl==4.6.2 (+ quack-kernels==0.6.4 for FA4 cute)
#   4) Editable TE from your fork branch; NVTE_WITH_NCCL_EP=0; NVTE_CUDA_ARCHS=100
#
# ---------------------------------------------------------------------------
# Pin the sglang BASE (torch comes from here; this Dockerfile does not reinstall
# torch). Prefer a formal release + digest — never floating tags like `dev-cu13`
# (Hub retargets them and torch/ABI drift silently).
#
# Prefer digest form (immutable):
#   --build-arg SGLANG_IMAGE=lmsysorg/sglang@sha256:<digest>
#
# Default base (formal release):
#   lmsysorg/sglang:v0.5.12-cu130
#     @sha256:42194170546745092e74cd5f81ad32a7c6e944c7111fe7bf13588152277ff356
#     torch 2.11.0+cu130  (flash_attn is built from source against this torch)
#
# Historical refs (override SGLANG_IMAGE only if you still need them):
#   B200 1.0.9 nightly (torch 2.13.0+cu130):
#     lmsysorg/sglang@sha256:51e576f02368480c055c7aadb67590d82b172e2392123ce4cf4cc8251b2d8caf
#     (== nightly-dev-20260818-c0b6474b)
#   B300 1.0.9 era (torch 2.10.0+cu128):
#     was nightly-dev-20260511-aa7a9af1 — tag gone from Hub (404); need a mirror.
#
# Self-contained: this file has ZERO local COPY deps. Context can be empty.
# Private miniTE clone still needs BuildKit secret (optional if repo is public):
#   --secret id=gh_token,src=$HOME/.github_token
#
# Example builds:
#   # B300 (sm_103)
#   docker build -f patch/B300/dockerfile \
#     --build-arg FLASHINFER_CUDA_ARCH_LIST=10.3 \
#     --build-arg FLASH_ATTN_CUDA_ARCH_LIST=10.3 \
#     --build-arg NVTE_CUDA_ARCHS=103 \
#     -t fy121415/dev-cu13-minite-b300-1.0.x:latest .
#
#   # B200 (sm_100)
#   docker build -f patch/B300/dockerfile \
#     --secret id=gh_token,src=$HOME/.github_token \
#     --build-arg FLASHINFER_CUDA_ARCH_LIST=10.0 \
#     --build-arg FLASH_ATTN_CUDA_ARCH_LIST=10.0 \
#     --build-arg NVTE_CUDA_ARCHS=100 \
#     -t fy121415/dev-cu13-minite-b200-1.0.x:latest .
#
# arm64 example:
#   --build-arg SGLANG_IMAGE=lmsysorg/sglang:v0.5.10-cu130 \
#   --build-arg WHEELS_TAG=cu130-aarch64
# ---------------------------------------------------------------------------

# Full image ref: `repo:tag` OR `repo@sha256:…`. Digest form is required for
# reproducible builds. Default = formal v0.5.12-cu130 (torch 2.11.0+cu130).
ARG SGLANG_IMAGE=lmsysorg/sglang@sha256:42194170546745092e74cd5f81ad32a7c6e944c7111fe7bf13588152277ff356
FROM ${SGLANG_IMAGE} AS sglang

# Repo ARGs are declared next to the RUN that uses them, so changing
# miniTransformer / sglang / slime does not bust earlier wheel/TE layers.
ARG ENABLE_CUDA_13=1

# ======================================== Setup =============================================

WORKDIR /root/

# ======================================== Apt dependencies =============================================

RUN apt update
# ethtool for network diagnostics
RUN apt install -y nvtop rsync dnsutils ethtool ccache

# nccl-tests for diagnostics
RUN git clone https://github.com/NVIDIA/nccl-tests.git /tmp/nccl-tests && \
    cd /tmp/nccl-tests && \
    git checkout ae98985f5599617be94042f4aa3637d10014ce89 && \
    make -j$(nproc) CUDA_HOME=/usr/local/cuda && \
    cp /tmp/nccl-tests/build/*_perf /usr/local/bin/ && \
    rm -rf /tmp/nccl-tests

# ====================================== Download pre-built wheels ============================================

ARG WHEELS_REPO=yueming-yuan/miles-wheels
ARG WHEELS_TAG=cu130-x86_64

# Only fetch wheels the later RUNs actually install. Downloading the full
# release (~1.7GB) would stay in this layer even after `rm -rf /tmp/wheels`.
RUN mkdir -p /tmp/wheels && \
    curl -sL "https://api.github.com/repos/${WHEELS_REPO}/releases/tags/${WHEELS_TAG}" \
    | python3 -c "import sys, json, subprocess, os; \
keep = ('flash_attn_3-', 'apex-', 'fake_int4_quant_cuda-', 'sglang_router-', 'sgl-model-gateway-linux-', 'causal_conv1d-', 'mamba_ssm-'); \
assets = [a for a in json.load(sys.stdin)['assets'] if a['name'].endswith(('.whl', '.tar.gz')) and a['name'].startswith(keep)]; \
[subprocess.run(['curl', '--retry', '20', '--retry-delay', '5', '--retry-all-errors', '-fSL', '-o', '/tmp/wheels/' + a['name'], a['browser_download_url']], check=True) for a in assets]; \
print('downloaded', [a['name'] for a in assets])" && \
    ls -lh /tmp/wheels/

# ====================================== Python dependencies ============================================

# flash-attn: build from source against the base-image torch (ABI-safe).
# Do NOT install the miles prebuilt flash_attn wheel — it is often compiled
# against a different torch and breaks with undefined COW symbols.
# Override tag / arches:
#   --build-arg FLASH_ATTN_REF=v2.7.4.post1
#   --build-arg FLASH_ATTN_CUDA_ARCH_LIST=10.0          # B200 only
#   --build-arg FLASH_ATTN_CUDA_ARCH_LIST=10.3          # B300 only
ARG FLASH_ATTN_REF=v2.7.4.post1
ARG FLASH_ATTN_CUDA_ARCH_LIST=10.0;10.3
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.ccache \
    set -eu; \
    pip uninstall -y flash-attn flash_attn 2>/dev/null || true; \
    rm -rf /tmp/flash-attention; \
    git clone --depth 1 --branch "${FLASH_ATTN_REF}" \
      https://github.com/Dao-AILab/flash-attention.git /tmp/flash-attention; \
    cd /tmp/flash-attention; \
    git submodule update --init csrc/cutlass; \
    mkdir -p csrc/composable_kernel; \
    printf '%s\n' \
      'from pathlib import Path' \
      'p = Path("setup.py")' \
      'lines = []' \
      'for line in p.read_text().splitlines(True):' \
      '    if "composable_kernel" in line and ("submodule" in line or "subprocess" in line):' \
      '        lines.append("# patched-out: " + line)' \
      '    else:' \
      '        lines.append(line)' \
      'p.write_text("".join(lines))' \
      'print("patched setup.py to skip composable_kernel submodule")' \
      > /tmp/patch_flash_attn_setup.py && \
    python3 /tmp/patch_flash_attn_setup.py && \
    rm -f /tmp/patch_flash_attn_setup.py; \
    export FLASH_ATTENTION_FORCE_BUILD=TRUE; \
    export FLASH_ATTENTION_SKIP_CUDA_BUILD=FALSE; \
    export MAX_JOBS="$(nproc)"; \
    export TORCH_CUDA_ARCH_LIST="${FLASH_ATTN_CUDA_ARCH_LIST}"; \
    pip install --no-build-isolation --no-deps -v .; \
    cd / && rm -rf /tmp/flash-attention; \
    python3 -c "import flash_attn, flash_attn_2_cuda; print('flash_attn', flash_attn.__version__)"

# flash-attn hopper (still from miles wheels; separate package from FA2)
RUN pip install --no-deps /tmp/wheels/flash_attn_3-*.whl && \
    python_path=$(python -c "import site; print(site.getsitepackages()[0])") && \
    mkdir -p $python_path/flash_attn_3 && \
    curl -fSL https://raw.githubusercontent.com/Dao-AILab/flash-attention/fbf24f67cf7f6442c5cfb2c1057f4bfc57e72d89/hopper/flash_attn_interface.py \
      -o $python_path/flash_attn_3/flash_attn_interface.py

RUN pip install git+https://github.com/ISEEKYAN/mbridge.git@89eb10887887bc74853f89a4de258c0702932a1c --no-deps

RUN pip install flash-linear-attention==0.4.2
RUN pip install tilelang -f https://tile-ai.github.io/whl/nightly/cu128/

# Mamba kernels: use prebuilt wheels (do not compile causal-conv1d from source).
RUN pip install --no-deps /tmp/wheels/causal_conv1d-*.whl && \
    pip install --no-deps /tmp/wheels/mamba_ssm-*.whl

# TE: editable install from fy1214 fork (NVFP4 per-token / #3045 work).
# Default branch = feature/grouped-per-token-sf-swizzle (container minite_repack).
#
# Env flags proven required for CUDA 13 image builds:
#   NVTE_WITH_NCCL_EP=0   — else missing nccl_device.h
#   NVTE_CUDA_ARCHS=100   — B200; use 103 (or 100;103) for B300 / dual
#   NVTE_FRAMEWORK=pytorch
#
# Note on "cherry-pick 930c8e45": that was only needed when building a clean
# NVIDIA PR-3045 baseline on mingfa-minify (nvcc 13.0 group_quantize_fp8.cuh
# parse failure). Your fork branch already builds without it; leave
# TE_CHERRY_PICK empty unless you intentionally rebuild from TE_BASE_COMMIT.
ARG CUTLASS_DSL_VERSION=4.6.2
# FA4 cute must be new enough for cutlass-dsl 4.6+ (ThrMma moved off cute.core).
# Base/sglang often leaves flash-attn-4==4.0.0b13 which still imports cute.core.ThrMma.
ARG FLASH_ATTN_4_VERSION=4.0.0b29
ARG TE_REPO=fy1214/TransformerEngine
ARG TE_BRANCH=feature/grouped-per-token-sf-swizzle
ARG TE_COMMIT=""
ARG TE_CHERRY_PICK=""
ARG NVTE_CUDA_ARCHS=100
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.ccache \
    set -eu; \
    pip install "nvidia-cublas==13.3.0.5"; \
    if [ "${ENABLE_CUDA_13}" = "1" ]; then \
      pip install nvidia-mathdx==25.6.0; \
    fi; \
    pip install --force-reinstall \
      "nvidia-cutlass-dsl==${CUTLASS_DSL_VERSION}" \
      "nvidia-cutlass-dsl[cu13]==${CUTLASS_DSL_VERSION}"; \
    # cutlass-dsl 4.6.x cute.compile needs map_dataclass_to_tuple; FA4>=b26 wants tvm-ffi>=0.1.12.
    pip install --force-reinstall "apache-tvm-ffi>=0.1.12,<0.2"; \
    pip install --no-deps "quack-kernels==0.6.4" || \
      pip install "quack-kernels==0.6.4"; \
    # Overwrite base/sglang flash_attn/cute with a 4.6.2-compatible FA4.
    pip install --force-reinstall --no-deps "flash-attn-4==${FLASH_ATTN_4_VERSION}"; \
    python3 -c "from flash_attn.cute.interface import flash_attn_func; print('FA4 cute OK', flash_attn_func)"; \
    pip uninstall -y transformer-engine transformer_engine transformer_engine_torch \
      transformer_engine_cu12 transformer_engine_cu13 2>/dev/null || true; \
    rm -rf /root/TransformerEngine; \
    git clone --recursive "https://github.com/${TE_REPO}.git" /root/TransformerEngine; \
    cd /root/TransformerEngine; \
    if [ -n "${TE_COMMIT}" ]; then \
      git checkout "${TE_COMMIT}"; \
    else \
      git checkout "${TE_BRANCH}"; \
    fi; \
    git submodule update --init --recursive; \
    if [ -n "${TE_CHERRY_PICK}" ]; then \
      git config user.email "builder@local"; \
      git config user.name "TE Builder"; \
      if ! git cat-file -t "${TE_CHERRY_PICK}" >/dev/null 2>&1; then \
        git fetch https://github.com/NVIDIA/TransformerEngine.git "${TE_CHERRY_PICK}"; \
      fi; \
      git cherry-pick --allow-empty "${TE_CHERRY_PICK}"; \
    fi; \
    rm -rf build; \
    export NVTE_FRAMEWORK=pytorch; \
    export NVTE_WITH_NCCL_EP=0; \
    export NVTE_CUDA_ARCHS="${NVTE_CUDA_ARCHS}"; \
    export MAX_JOBS="$(nproc)"; \
    if [ "${ENABLE_CUDA_13}" = "1" ]; then \
      export CPLUS_INCLUDE_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/cu13/include; \
      export LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/cu13/lib; \
    fi; \
    # --no-deps below skips TE pyproject build/runtime deps; install them explicitly.
    pip install pybind11 ninja onnxscript onnx; \
    pip -v install --no-build-isolation --no-deps --force-reinstall -e .; \
    echo "TE editable install OK (smoke import after FA4 patch)"

# TE smoke: FA4 cute must import cleanly with pinned cutlass-dsl / flash-attn-4.
# Fail the build on drift (no soft-fail patch file).
RUN python3 -c "import transformer_engine as te; import transformer_engine.pytorch as tep; from transformer_engine.pytorch.attention.dot_product_attention import backends as _b; assert _b.flash_attn_func_v4 is not None, 'FA4 cute missing'; print('TE', te.__version__, 'FA4', _b.flash_attn_func_v4)"

